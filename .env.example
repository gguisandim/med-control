# Senha única de acesso à aplicação. Nunca use NEXT_PUBLIC_ aqui.
APP_PASSWORD=troque-por-uma-senha-forte

# Segredo aleatório usado para assinar o cookie da sessão.
# Exemplo para gerar: openssl rand -hex 32
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY

# Fuso horário operacional do sistema.
APP_TIMEZONE=America/Belem
